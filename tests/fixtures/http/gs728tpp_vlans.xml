<?xml version="1.0" encoding="UTF-8" ?>
<ResponseData>
<MASTER ONLOAD="VlanConfig.disableDefaultVlan()">
<jscript SRC="Behaviour/VlanConfig.js"></jscript>
<screenName>VLAN Configuration</screenName>
<NODE TYPE="NG_buttonsPanel" ONLOAD="NG_buttonsPannel.draw()">
<NODE ID="Add" SRC="images/add_off.gif" ONCLICK="VlanConfig.Add()" />
<NODE ID="Delete" SRC="images/delete_off.gif" ONCLICK="NG_buttonsPannel.Delete()" ENABLED="false"/>
<NODE ID="Cancel" SRC="images/cancel_off.gif" ONCLICK="cancelBthClick()" ENABLED="false"/>
<NODE ID="Apply" SRC="images/apply_off.gif" ONCLICK="NG_buttonsPannel.Apply()" ENABLED="false"/>
</NODE>
<screenSection TITLE="VLAN Configuration" WIDTH = "425px" HELP_PRM="50">
<repeatedtable ID="_RT" OBJECT="RT" BIND="VLANList" MULTISELECT="true"
oWIDTH="100%" oCLASS = "repeatedTable" CLASS = "tableStyle">
<tr>
<th CLASS="tableFieldTitle1"></th>
<th CLASS="tableFieldTitleFirstCol">VLAN ID</th>
<th CLASS="tableFieldTitle2">VLAN Name</th>
<th CLASS="tableFieldTitle2">VLAN Type</th>
</tr>
<tr>
<td CLASS="tableFieldTitle11">
<checkbox ID="chkAll" ONCLICK="VlanConfig.checkAll('_RT','selectRow',this);NG_buttonsPannel.setFieldDisable('_RT','txtVlanId');disableControls(['Add'],true)"/>
</td>
<td CLASS="tableFieldTitle11FirstCol">
<inputtext ID="txtVlanId" CLASS="xuiInputTextEnabled" VALID_TYPE="2" FIELD_NAME="VLAN Id" MIN_VALUE="2" MAX_VALUE="4093" MANDATORY="1" DISABLE_ON_MULTY = "true" MAXLENGTH="4" ONCLICK="VlanConfig.disableAddButton()" ONCHANGE="VlanConfig.disableAddButton()" />
</td>
<td CLASS="tableFieldTitle22">
<inputtext ID="txtVlanName" CLASS="xuiInputTextEnabled" VALID_TYPE="109" FIELD_NAME="VLAN Name" MAXLENGTH="32" DISABLE_ON_MULTY = "true" oMANDATORY="1" ONCLICK="VlanConfig.disableAddButton()" ONCHANGE="VlanConfig.disableAddButton()" />
</td>
<td CLASS="tableFieldTitle22">
</td>
</tr>
<repeatedrow BIND="VLAN" CLASS="repeated_row" CLASS_ODD="repeated_row_odd" CLASS_SELECTED="selectRow">
<repeatedcell CLASS="tableField">
<checkbox TYPE="checkbox" ONCLICK="VlanConfig.selectRTRow(this)" />
</repeatedcell>
<repeatedcell BIND="VLANID" RELATED_ID="txtVlanId" CLASS="messageTableBorderFirstCol" />
<repeatedcell BIND="VLANName" RELATED_ID="txtVlanName" CLASS="messageTableBorder" />
<repeatedcell BIND="VLANType" ENUM="true" CLASS="messageTableBorder"></repeatedcell>
</repeatedrow>
</repeatedtable>
</screenSection>
<screenSection TITLE="Reset" WIDTH = "425px" HELP_PRM="50">
<table ID="tblResetConf" CLASS="tableStyle">
<tr>
<td CLASS="black10b">Reset Configuration </td>
<td CLASS="black10">
<checkbox TYPE="checkbox" ID="chkReset" ONCLICK="VlanConfig.Reset(this);" />
</td>
</tr>
</table>
</screenSection>
<ENUM>
<VLANType>
<NODE VALUE="1">Default</NODE>
<NODE VALUE="2">Static</NODE>
<NODE VALUE="3">Dynamic</NODE>
